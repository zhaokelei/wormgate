{
  "name": "tunnelx-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite --config vite.client.config.js",
    "dev:admin": "vite --config vite.admin.config.js",
    "dev:next": "npm --prefix next run dev",
    "build:client": "vite build --config vite.client.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "build:next": "npm --prefix next run build",
    "build": "npm run build:client && npm run build:admin && npm run build:next"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "echarts": "^5.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright-core": "^1.65.0",
    "vite": "^6.1.0"
  }
}
